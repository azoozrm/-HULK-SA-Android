+package sa.hulksa.player.data
+
+import android.util.Log
+import okhttp3.Call
+import okhttp3.EventListener
+import okhttp3.Response
+import java.io.IOException
+
+/**
+ * R25 comparison-only observation. Logs one safe action label and the HTTP status/cancel event
+ * for every provider call. It never logs a URL, query, header, body, credential or account.
+ * Added only to the historical A comparison build by the closed comparison workflow.
+ */
+internal class R25HttpTrace : EventListener() {
+    private fun action(call: Call): String =
+        call.request().url.queryParameter("action")?.takeIf(String::isNotBlank) ?: "auth"
+
+    override fun callStart(call: Call) {
+        Log.i(TAG, "v=1 src=r25 ev=call action=${action(call)}")
+    }
+
+    override fun responseHeadersEnd(call: Call, response: Response) {
+        Log.i(
+            TAG,
+            "v=1 src=r25 ev=status action=${action(call)} code=${response.code}",
+        )
+    }
+
+    override fun canceled(call: Call) {
+        Log.i(TAG, "v=1 src=r25 ev=terminal action=${action(call)} outcome=CANCELED")
+    }
+
+    override fun callFailed(call: Call, ioe: IOException) {
+        Log.i(TAG, "v=1 src=r25 ev=terminal action=${action(call)} outcome=NETWORK")
+    }
+
+    private companion object {
+        const val TAG = "HulkTrace"
+    }
+}
