<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="hulk_black">#050505</color>
    <color name="hulk_gold">#D4B351</color>
    <color name="hulk_icon_background">#000000</color>
    <color name="hulk_icon_gold">#D9B54F</color>
    <color name="ic_launcher_background">#07090B</color>
    <string name="app_name">HULK SA</string>
    <style name="Theme.HulkSA" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/hulk_black</item>
        <item name="android:navigationBarColor">@color/hulk_black</item>
        <item name="android:windowBackground">@color/hulk_black</item>
        <item name="android:colorAccent">@color/hulk_gold</item>
    </style>
    <style name="Theme.HulkSA.TV" parent="Theme.HulkSA">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>