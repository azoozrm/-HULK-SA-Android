<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Many licensed Xtream portals still expose MPEG-TS over HTTP. HTTPS control
         endpoints remain certificate-validated against system CAs only. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
