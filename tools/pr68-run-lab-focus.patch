+def normalized_label(value: str) -> str:
+    return " ".join(value.split())
+
+
+def xml_contains_label(xml_bytes: bytes, expected: str) -> bool:
+    try:
+        root = ET.fromstring(xml_bytes)
+    except ET.ParseError:
+        return False
+    wanted = normalized_label(expected)
+    return any(wanted in normalized_label(node_text(node)) for node in root.iter("node"))
+
+
+def download_card_marker_count(xml_bytes: bytes) -> int:
+    try:
+        root = ET.fromstring(xml_bytes)
+    except ET.ParseError:
+        return 0
+    return sum(
+        "qa-tv-download-card:" in node.attrib.get("content-desc", "")
+        for node in root.iter("node")
+    )
+
