{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "minimum_api", "current_api", "profiles", "tiers", "physical_targets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "minimum_api": {"type": "integer", "minimum": 1},
    "current_api": {"type": "integer", "minimum": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "family", "api", "width_px", "height_px", "density_dpi", "orientations", "font_scales", "evidence_level"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "family": {"type": "string", "enum": ["phone", "tablet", "tv"]},
          "api": {"type": "integer", "minimum": 1},
          "width_px": {"type": "integer", "minimum": 1},
          "height_px": {"type": "integer", "minimum": 1},
          "density_dpi": {"type": "integer", "minimum": 1},
          "orientations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["portrait", "landscape"]}
          },
          "font_scales": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "number", "minimum": 0.5}
          },
          "evidence_level": {"type": "string", "enum": ["emulator", "simulation"]}
        }
      }
    },
    "tiers": {"type": "object"},
    "physical_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["NOT_EXECUTED", "BLOCKED", "PASS", "FAIL"]}
        }
      }
    }
  }
}

